sub process_open {
    my @arg = @_;
    require Browser::Open;
    my $cmd = Browser::Open::open_browser_cmd();
    foreach my $oid ( @arg ) {
	my $url = heavens_above_url( $oid );
	system { $cmd } $cmd, $url;
    }
    return;
}

sub process_parse {
    my ( $handler, @arg ) = @_;
    my $name_table = ref( $arg[0] ) eq REF_HASH ? shift @arg : {};
    foreach my $spec ( @arg ) {
	my $get = $spec =~ m/ \A [0-9]+ \z /smx ? \&get_html : \&get_file;
	my $tree = HTML::TreeBuilder->new_from_content( $get->( $spec ) );
	# print $tree->as_HTML();
	# Should return a <span>..</span> containing the OID
	my $oid = find_span( $tree, 'ctl00_cph1_lblSatID' );
	# Should return a <span>..</span> containing the name
	my $name = $name_table->{$oid} //
	    find_span( $tree, 'ctl00_cph1_lblOIGName' );
	# We would like to look for id ctl00_cph1_lblBrightness here, but it
	# contains table rows (which it should not), so HTML::TreeBuilder
	# spits it out any old where. Sometimes before the table, sometimes
	# in the middle of it (but still empty). So we just have to hope the
	# default display is English.
	my $mag = find_td_by_content(
	    $tree, qr< \b at \s+ 1000 \s* km \s+ distance \b >smxi );

	my $source;
	state $config = get_config();

	if ( defined $mag ) {
	    $source = 'Heavens Above';
	} elsif ( $mag = $config->{$oid} ) {
	    $source = $mag->{source};
	    $mag = $mag->{mag};
	}
	$handler->( {
		id	=> $oid,
		name	=> $name,
		mag	=> $mag,
		source	=> $source,
	    }
	);
    }
    return;
}

sub process_perl {
    my ( @arg ) = @_;
    process_parse( \&print_perl, @arg );
    return;
}

1;

__END__

=head1 TITLE

heavens-above-mag - Get magnitudes from Heavens Above

=head1 SYNOPSIS

 heavens-above-mag 25544
 heavens-above-mag --help
 heavens-above-mag --version

=head1 OPTIONS

=head2 --age

 --age 43200

This option specifies the maximum age of the cache, in seconds. Setting
C<--age=0> disables the cache.

The default is C<--age=86400>, i.e. one day.

=head2 --celestrak

If this Boolean option is asserted, the OIDs come from Celestrak's
F<visual.txt> file, and the output is the canned magnitude table in
L<Astro::Coord::ECI::TLE|Astro::Coord::ECI::TLE>. If this option is
asserted, no non-option arguments may be specified, and
L<--open|/--open> is ignored.

The default is the value of L<--update|/--update>.

=head2 --clear

This option causes the cache to be cleared before any magnitudes are
retrieved. The script will exit afterwards unless either arguments or
L<--celestrak|/--celestrak> were specified.

If more than one of C<--clear>, L<--purge|/--purge>, or
L<--touch|/--touch> is specified, the last-specified wins.

=head2 --config

This option specifies the location of a magnitude configuration file.
The default is F<mets/magnituderc>. See L<CONFIGURATION|/CONFIGURATION>
below for more.

The default configuration file need not exist, but an
explicitly-specified configuration file must exist.

=head2 --delay

This option specifies the number of seconds between web fetches.

The default is C<--delay 5>.

=head2 --help

This option displays the documentation for this script. The script then
exits.

=head2 --open

If this Boolean option is asserted, a web browser is spawned, displaying
the Heavens-Above web page of the OIDs specified. You cannot specify
file names if you specify this option.

=head2 --purge

This option causes the cache to be purged before any magnitudes are
retrieved. The script will exit afterwards unless either arguments or
L<--celestrak|/--celestrak> were specified.

If more than one of L<--clear|/--clear>, C<--purge>, or
L<--touch|/--touch> is specified, the last-specified wins.

=head2 --touch

This option causes the creation time of all objects in the cache to be
reset to the current time before any magnitudes are retrieved. The
script will exit afterwards unless either arguments or
L<--celestrak|/--celestrak> were specified.

If more than one of L<--clear|/--clear>, L<--purge|/--purge>, or
C<--touch> is specified, the last-specified wins.

=head2 --update

This option causes everything between the lines

 # $$ BEGIN magnitude_table

and

 # $$ END

in F<lib/Astro/Coord/ECI/TLE.pm> to be replaced by the output
of the L<--celestrak|/--celestrak> option. An error is reported if the
file can not be opened, or if the markers are not found.

The default is C<--no-update>.

=head2 --user-agent

 --user-agent Wget/1.25.0

This option specifies the user agent string for web queries. The default
is the default L<LWP::UserAgent|LWP::UserAgent> string.

=head2 --verbose

If this Boolean option is asserted, whatever information the author
deems useful is displayed on C<STDERR>.

The default is C<--no-verbose>.

=head2 --version

This option displays the version of this script. The script then exits.

=head1 DETAILS

This Perl script parses intrinsic magnitude data out of Heavens Above
data. You can specify either an OID (which is fetched) or a file name
(which is read) or a mixture of the two.

Heavens Above defines intrinsic magnitude as the magnitude at a range of
1000km, and 50% illuminated.

All web I/O goes through a cache in top-level project directory
F<cache/>. Data will come from the cache rather than the web if the file
in the cache is newer than the value of the L<--age|/--age> option. The
cache directory will be created if necessary.

=head1 CONFIGURATION

Besides scraping Heavens Above, magnitudes can come from a configuration
file. By default this is L<meta/magnituderc>, but a different one can be
specified using the L<--config|/--config> option.

The configuration file allows comments beginning with C<#>, either
full-line or end-of-line. These are stripped. Any line containing no
non-white-space characters after this operation is ignored.

Configuration lines are of the form C<name = value>. The following names
are allowed:

=over

=item * An unsigned integer

This is interpreted as an OID. The value is the default magnitude for
that object, assuming one can not be obtained from Heavens Above.

=item * C<age>

This specifies a value for the L<--age|/--age> option. The value must be
an unsigned integer number of seconds.

=item * C<delay>

This specifies a value for the L<--delay|/--delay> option. The value
must be an unsigned integer number of seconds.

=item * C<source>

This specifies the name of the source for all subsequent magnitudes
until the next C<source> specification. The default is the name of the
configuration file.

=item * C<user_agent>

This specifies the user agent string for all web requests. The default
is the default L<LWP::UserAgent|LWP::UserAgent> string.

=back

